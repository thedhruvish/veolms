POSTGRES_DB=veolms
POSTGRES_USER=veolms
POSTGRES_PASSWORD=veolms
POSTGRES_PORT=5433
DATABASE_URL=postgresql://veolms:veolms@localhost:5433/veolms
API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development
API_DEV_PRETTY_LOGS=true
API_DOCS_ENABLED=true
