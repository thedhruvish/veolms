# ==============================================================================
# VeoLMS Media Worker - Environment Configuration Reference (.env.example)
#
# QUICK START:
# 1. Interactive Setup (Recommended):
#    pnpm run fleet:pre:setup
#
# 2. Manual Setup:
#    cp apps/media-worker/.env.example apps/media-worker/.env.local
#    (Fill in your values below)
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] Worker Identity & Control Plane Networking
# ------------------------------------------------------------------------------
# Unique identifier for this worker instance (auto-generated if omitted)
WORKER_ID=worker-01

# Cloud or container instance ID (auto-generated if omitted)
INSTANCE_ID=inst-01

# Worker Infrastructure Provider Type:
# Choices: 'local_process' | 'local_podman' | 'local_docker' | 'simulator' | 'aws_spot' | 'aws_ecs'
PROVIDER=local_process

# Hardware or cloud VM instance sizing tier (e.g. 'standard', 'c6i.2xlarge', 'gpu-t4')
INSTANCE_TYPE=standard

# Control Plane API endpoint for registration, heartbeats, and coordination
FLEET_MANAGER_API_URL=http://127.0.0.1:4000

# PostgreSQL connection string for claiming jobs from Queue 2
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veolms

# Optional dedicated queue connection string (falls back to DATABASE_URL if omitted)
# QUEUE_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/veolms

# Heartbeat ping interval to the Control Plane in milliseconds (Default: 3000)
HEARTBEAT_INTERVAL_MS=3000

# Number of concurrent chunks this single worker process can encode (Default: 1)
CONCURRENCY=1

# ------------------------------------------------------------------------------
# [2] Local Storage & Scratch Directories
# ------------------------------------------------------------------------------
# Root storage driver: 'local' (filesystem) | 's3' (object storage)
STORAGE_DRIVER=local

# Local root directory for finalized production HLS playlists and media segments
STORAGE_BASE_PATH=./s3-bucket

# Local scratch directory for temporary raw split chunks (chunk-01.mp4)
TEMP_STORAGE_PATH=./s3-bucket/temp

# Fast local NVMe/RAM scratch directory for active FFmpeg transcoding workspaces
SCRATCH_DIR=/tmp/veolms-media-worker

# ------------------------------------------------------------------------------
# [3] S3-Compatible Object Storage (AWS S3, Cloudflare R2, MinIO, Wasabi, etc.)
# ------------------------------------------------------------------------------
# Set STORAGE_DRIVER=s3 to activate remote object storage for both tiers,
# or configure TEMP_STORAGE_DRIVER / PROD_STORAGE_DRIVER independently.
#
# 🔐 NOTE ON AWS IAM ROLES:
# When running on AWS EC2, ECS, or Lambda with an attached IAM Role, leave
# ACCESS_KEY and SECRET_KEY blank! The AWS SDK automatically assumes the
# instance profile / task role permissions with ZERO hardcoded keys needed.

# --- Global / Fallback S3 Settings ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- Tier 1: Temporary Scratch S3 Bucket (Split raw chunks: chunk-*.mp4) ---
# S3_TEMP_BUCKET=veolms-temp-scratch-bucket
# S3_TEMP_REGION=us-east-1
# S3_TEMP_ENDPOINT=
# S3_TEMP_ACCESS_KEY=
# S3_TEMP_SECRET_KEY=

# --- Tier 2: Production S3 Bucket (Finalized HLS master.m3u8 & .ts segments) ---
# S3_PROD_BUCKET=veolms-production-media-bucket
# S3_PROD_REGION=us-east-1
# S3_PROD_ENDPOINT=
# S3_PROD_ACCESS_KEY=
# S3_PROD_SECRET_KEY=

# ------------------------------------------------------------------------------
# [4] Video Transcoding & FFmpeg Tuning
# ------------------------------------------------------------------------------
# FFmpeg speed preset: 'ultrafast' | 'superfast' | 'veryfast' | 'faster' | 'fast' | 'medium' | 'slow'
FFMPEG_PRESET=veryfast

# Constant Rate Factor (CRF) quality target (18=High Quality, 22=Standard, 28=Low Bitrate)
DEFAULT_CRF=22

# HLS media segment duration in seconds (Default: 6s)
HLS_SEGMENT_DURATION_SECONDS=6

# Set to true to disable GPU hardware acceleration (NVENC/QSV/VAAPI) and force libx264 software CPU
FORCE_SOFTWARE_ENCODER=false

# ------------------------------------------------------------------------------
# [5] Container Runtime Settings (When running under Podman or Docker)
# ------------------------------------------------------------------------------
# Container runtime binary: 'podman' | 'docker'
# CONTAINER_ENGINE=podman

# Container image tag for worker instances
# CONTAINER_IMAGE=localhost/veolms-media-worker:latest
