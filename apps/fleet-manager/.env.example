# ==============================================================================
# VeoLMS Fleet Manager - Environment Configuration Reference (.env.example)
#
# QUICK START:
# 1. Interactive Setup (Recommended):
#    pnpm run fleet:pre:setup
#
# 2. Manual Setup:
#    cp apps/fleet-manager/.env.example apps/fleet-manager/.env.local
#    (Fill in your values below)
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] Database & State Settings
# ------------------------------------------------------------------------------
# Primary PostgreSQL Database connection string (Postgres / Neon Serverless)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veolms

# Dedicated queue connection string (falls back to DATABASE_URL if omitted)
# QUEUE_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/veolms

# ------------------------------------------------------------------------------
# [2] Control Plane Architecture & HTTP API Server
# ------------------------------------------------------------------------------
# Control Plane Architecture: 'serverful' (HTTP Daemon) | 'serverless' (AWS Lambda / SQS)
CONTROL_PLANE_MODE=serverful

# Daemon listener TCP port (Default: 4000)
PORT=4000

# Daemon listener host binding (Default: 127.0.0.1)
HOST=127.0.0.1

# Public URL of the Fleet Manager API advertised to workers
FLEET_MANAGER_API_URL=http://127.0.0.1:4000

# Scheduling loop execution interval in milliseconds (Default: 2000)
COORDINATION_INTERVAL_MS=2000

# ------------------------------------------------------------------------------
# [3] Cloud Driver & Infrastructure Provider Plugin
# ------------------------------------------------------------------------------
# Infrastructure Provider Plugin: 'local' | 'simulator' | 'aws'
PROVIDER=local

# Local Runner Execution Mode: 'process' (bare-metal Node.js) | 'podman' | 'docker'
RUNNER_MODE=process

# Container image tag when using podman/docker runner
# CONTAINER_IMAGE=localhost/veolms-media-worker:latest

# ------------------------------------------------------------------------------
# [4] Storage Paths & Asset Routing
# ------------------------------------------------------------------------------
# Root storage path for production HLS streams
STORAGE_BASE_PATH=./s3-bucket

# Scratch storage path for raw split video chunks
TEMP_STORAGE_PATH=./s3-bucket/temp

# ------------------------------------------------------------------------------
# [5] Auto-Scaling, Capacity Allocation, and Health Thresholds
# ------------------------------------------------------------------------------
# Maximum concurrent worker processes allowed per single video processing job (Default: 4)
MAX_WORKERS_PER_VIDEO=4

# Global ceiling on total concurrent workers across all jobs (Default: 10)
MAX_TOTAL_WORKERS=10

# Completion percentage (Formula B) where near-finished workers are reused (Default: 85)
REUSE_PROGRESS_THRESHOLD=85

# Worker inactivity grace period in seconds before issuing TERMINATE signal (Default: 10s)
IDLE_TIMEOUT_SECONDS=10

# Worker heartbeat expiration threshold in seconds before marking worker DEAD (Default: 15s)
HEARTBEAT_TIMEOUT_SECONDS=15

# Force software CPU encoding on all launched worker instances (Default: false)
FORCE_SOFTWARE_ENCODER=false

# ------------------------------------------------------------------------------
# [6] Simulator Plugin Specific Options (When PROVIDER=simulator)
# ------------------------------------------------------------------------------
# SIMULATOR_TICK_INTERVAL_MS=1000
# SIMULATOR_CHUNK_DURATION_SECONDS=300
# SIMULATOR_SIMULATE_FAILURES=false

# ------------------------------------------------------------------------------
# [7] AWS Cloud Driver Options (When PROVIDER=aws)
# ------------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_EC2_AMI_ID=ami-0123456789abcdef0
# AWS_SUBNET_ID=subnet-0123456789abcdef0
# AWS_IAM_ROLE_ARN=arn:aws:iam::123456789012:instance-profile/VeoLMSWorkerProfile
